{
  "manifest_version": 3,
  "key": "",
  "name": "Marknest · 书签管家",
  "version": "1.3.0",
  "description": "分组管理、标签、搜索与重复检测的云同步书签管理器，数据随 Google 账户自动同步。",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "activeTab",
    "contextMenus",
    "sidePanel",
    "bookmarks"
  ],
  "action": {
    "default_title": "打开 Marknest 书签侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}